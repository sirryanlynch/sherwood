rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function emailOk(value) {
      return value is string
        && value.size() > 3
        && value.size() < 200
        && value.matches('^[^@\s]+@[^@\s]+\.[^@\s]+$');
    }
    function slugOk(value) {
      return value == null
        || (value is string && value.size() > 1 && value.size() < 64 && value.matches('^[a-z0-9-]+$'));
    }
    function addressOk(value) {
      return value == null || (value is string && value.size() < 300);
    }
    function srcOk(data) {
      return !('src' in data)
        || data.src == null
        || (data.src is string && data.src.size() > 0 && data.src.size() < 65 && data.src.matches('^[A-Za-z0-9._-]+$'));
    }
    function utmOk(data) {
      return !('utm' in data) || (data.utm is map && data.utm.size() < 9);
    }

    match /reminders/{id} {
      allow read, update, delete: if false;
      allow create: if request.resource.data.keys().hasOnly([
          'email', 'county_slug', 'address', 'window_opens_at', 'status',
          'created_at', 'marketing_consent', 'consent_source', 'consent_requested_at',
          'src', 'utm'
        ])
        && emailOk(request.resource.data.email)
        && slugOk(request.resource.data.county_slug)
        && addressOk(request.resource.data.address)
        && request.resource.data.status == 'pending'
        && request.resource.data.marketing_consent == true
        && request.resource.data.consent_source is string
        && request.resource.data.consent_source.size() > 1
        && request.resource.data.consent_source.size() < 64
        && request.resource.data.created_at == request.time
        && request.resource.data.consent_requested_at == request.time
        && (request.resource.data.window_opens_at == null
          || (request.resource.data.window_opens_at is string
            && request.resource.data.window_opens_at.matches('^\d{4}-\d{2}-\d{2}$')))
        && srcOk(request.resource.data)
        && utmOk(request.resource.data);
    }

    match /leads/{id} {
      allow read, update, delete: if false;
      allow create: if request.resource.data.keys().hasOnly([
          'email', 'county_slug', 'address', 'outcome', 'consent_source', 'created_at',
          'src', 'utm'
        ])
        && emailOk(request.resource.data.email)
        && slugOk(request.resource.data.county_slug)
        && addressOk(request.resource.data.address)
        && request.resource.data.outcome is string
        && request.resource.data.outcome.size() < 40
        && request.resource.data.consent_source is string
        && request.resource.data.consent_source.size() > 1
        && request.resource.data.consent_source.size() < 64
        && request.resource.data.created_at == request.time
        && srcOk(request.resource.data)
        && utmOk(request.resource.data);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
